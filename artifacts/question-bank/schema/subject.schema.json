{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cbse-practice-app.local/schemas/subject.schema.json",
  "title": "CBSE Subject Schema",
  "description": "Metadata for a subject inside a class.",
  "type": "object",
  "required": [
    "subject",
    "class",
    "chapters"
  ],
  "additionalProperties": false,
  "properties": {
    "subject": {
      "type": "string",
      "enum": ["Physics", "Chemistry", "Mathematics"]
    },
    "class": {
      "type": "integer",
      "enum": [9, 10, 11, 12]
    },
    "display_name": {
      "type": "string",
      "description": "Optional custom display name"
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^chapter-[0-9]{2}-[a-z0-9-]+$"
      },
      "description": "Ordered list of chapter_ids"
    },
    "total_chapters": {
      "type": "integer",
      "minimum": 1
    },
    "icon": {
      "type": ["string", "null"],
      "description": "Path to subject icon"
    },
    "color": {
      "type": ["string", "null"],
      "description": "Theme color hex code"
    }
  }
}
